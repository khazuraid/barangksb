# Database (Postgres 16)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=inventaris
DATABASE_URL="postgres://postgres:postgres@localhost:5432/inventaris?sslmode=disable"

# Redis & Worker Queue (URL connection link)
# Format: redis://[:password]@host:port/db atau redis://user:password@host:port/db
REDIS_URL="redis://default:change-in-prod-supersecure-redis-pass@redis:6379/0"
REDIS_PASSWORD="change-in-prod-supersecure-redis-pass"

# Server
PORT="8080"
APP_ENV="dev"

# JWT — WAJIB ganti di produksi (minimal 32 karakter acak)
# Generate: openssl rand -hex 32
JWT_SECRET=""

# CORS — comma-separated origins
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,https://barang.kesling.biz.id"

# MinIO (upload foto)
MINIO_ENDPOINT="minio:9000"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_BUCKET="inventaris"

# Telegram bot (opsional — bisa diisi via UI page Telegram)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_IDS=""

# Admin auto-seed (dipakai saat DB kosong saat pertama start)
ADMIN_EMAIL="admin@kantor.id"
ADMIN_PASSWORD="admin12345"
