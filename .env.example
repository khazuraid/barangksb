# Database (Postgres 16)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=inventaris
DATABASE_URL="postgres://postgres:postgres@localhost:5432/inventaris?sslmode=disable"

# Redis & Worker Queue (URL connection link)
# Format: redis://[:password]@host:port/db atau redis://user:password@host:port/db
REDIS_URL="redis://default:change-in-prod-supersecure-redis-pass@redis:6379/0"
REDIS_PASSWORD="change-in-prod-supersecure-redis-pass"

# Server
PORT="8080"
APP_ENV="prod"
APP_PUBLIC_URL="https://barang.kesling.biz.id"
TRUSTED_PROXIES="127.0.0.1,::1,172.16.0.0/12"
# HOST_PORT="" # Opsional: set ke "8080" jika ingin bind langsung ke host localhost (kosongkan di Coolify)

# JWT — WAJIB ganti di produksi (minimal 32 karakter acak)
# Generate: openssl rand -hex 32
JWT_SECRET=""
JWT_TTL_HOURS="24"

# CORS — comma-separated origins
CORS_ORIGINS="https://barang.kesling.biz.id"

# Telegram bot (opsional — bisa diisi via UI page Telegram)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_IDS=""
ALLOW_PRIVATE_TELEGRAM_API="false"

# Admin auto-seed (dipakai saat DB kosong saat pertama start — WAJIB ganti password kuat)
ADMIN_EMAIL="admin@kantor.id"
ADMIN_PASSWORD="ganti-password-admin-kuat-minimal-12-karakter"
