# Database (Postgres 16)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/inventaris?sslmode=disable"

# Server
APP_PORT="8080"
# Ganti di produksi! Kunci cookie session (string acak 32+ char)
SESSION_KEY="dev-only-insecure-key"

# Google Drive (opsional — foto + import CSV)
# Service account JSON path + folder ID. Bagikan folder ke email service account.
GOOGLE_SA_JSON=""
GOOGLE_DRIVE_PHOTO_FOLDER_ID=""
GOOGLE_FOLDER_ID=""

# Telegram bot (opsional — notifikasi + input + pencarian)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_IDS=""
