# Database (Postgres 16)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/inventaris?sslmode=disable"

# Server
PORT="8080"
APP_ENV="dev"

# JWT — WAJIB ganti di produksi (minimal 32 karakter acak)
# Generate: openssl rand -hex 32
JWT_SECRET=""

# CORS — comma-separated origins
CORS_ORIGINS="https://barang.kesling.biz.id"

# MinIO (upload foto)
MINIO_ENDPOINT="minio:9000"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_BUCKET="inventaris"

# Telegram bot (opsional — bisa diisi via UI page Telegram)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_IDS=""

# Admin auto-seed (dipakai saat DB kosong saat pertama start)
ADMIN_EMAIL="admin@kantor.id"
ADMIN_PASSWORD="admin12345"