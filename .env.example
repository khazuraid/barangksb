# Database (Postgres 16)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/inventaris?sslmode=disable"

# Server
PORT="8080"
APP_ENV="dev"

# JWT — WAJIB ganti di produksi (minimal 32 karakter acak)
JWT_SECRET=""

# CORS — comma-separated origins (produksi: set ke domain Anda)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# MinIO (upload foto)
MINIO_ENDPOINT="localhost:9000"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_BUCKET="inventaris"

# Telegram bot (opsional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_IDS=""

# Admin auto-seed (dipakai saat DB kosong saat pertama start)
ADMIN_EMAIL="admin@kantor.id"
ADMIN_PASSWORD="admin12345"