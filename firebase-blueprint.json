{
  "entities": {
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Master data barang inventaris kantor & aset dengan atribut standar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "unit": { "type": "string" },
        "pricePerUnit": { "type": "number" },
        "description": { "type": "string" },
        "photoUrl": { "type": "string" },
        "merk": { "type": "string" },
        "typeModel": { "type": "string" },
        "serialNumber": { "type": "string" },
        "procurementYear": { "type": "string" },
        "conditionStatus": { "type": "string" },
        "fundingSource": { "type": "string" },
        "distributor": { "type": "string" },
        "aklAkd": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "sku", "name", "category", "currentStock", "unit"]
    },
    "StockInTransaction": {
      "title": "StockInTransaction",
      "description": "Pencatatan riwayat barang masuk kantor beserta foto bukti dan spesifikasi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "itemId": { "type": "string" },
        "itemSku": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "supplierOrSource": { "type": "string" },
        "receivedBy": { "type": "string" },
        "invoiceOrPoNumber": { "type": "string" },
        "photoUrl": { "type": "string" },
        "merk": { "type": "string" },
        "typeModel": { "type": "string" },
        "serialNumber": { "type": "string" },
        "procurementYear": { "type": "string" },
        "conditionStatus": { "type": "string" },
        "fundingSource": { "type": "string" },
        "distributor": { "type": "string" },
        "aklAkd": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "timestamp", "itemId", "itemSku", "quantity"]
    },
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Daftar kategori barang inventaris kantor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/inventory_items/{itemId}": {
      "schema": "InventoryItem",
      "description": "Koleksi data master barang kantor"
    },
    "/stock_in_logs/{transactionId}": {
      "schema": "StockInTransaction",
      "description": "Koleksi transaksi barang masuk kantor lengkap dengan foto"
    },
    "/categories/{categoryId}": {
      "schema": "CategoryItem",
      "description": "Koleksi kategori barang"
    }
  }
}
