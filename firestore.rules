rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inventory_items/{itemId} {
      allow read, write: if true;
    }
    match /stock_in_logs/{transactionId} {
      allow read, write: if true;
    }
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
