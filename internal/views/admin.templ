package views

import "inventariskantor/internal/models"

// Users — kelola pengguna (admin).
type UsersData struct {
	User  UserInfo
	Users []models.UserRow
}

templ Users(d UsersData) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-users-group icon" style="color:var(--accent)"></i> Kelola Pengguna</h1>
			<div class="page-subtitle">{ fmtInt(len(d.Users)) } pengguna terdaftar</div>
		</div>
	</div>
	<div class="grid-2">
		<div class="panel" style="padding:20px">
			<div class="panel-title" style="margin-bottom:14px"><i class="ti ti-user-plus icon" style="color:var(--accent)"></i> Tambah / Reset</div>
			<form method="post" action="/users" class="stack">
				<label>Nama<input type="text" name="name" required/></label>
				<label>Email<input type="email" name="email" required/></label>
				<label>Password (min 8)<input type="password" name="password" required minlength="8"/></label>
				<label>Role
					<select name="role">
						<option value="petugas">Petugas</option>
						<option value="admin">Admin</option>
					</select>
				</label>
				<button type="submit" class="btn btn-primary btn-block"><i class="ti ti-device-floppy icon"></i> Simpan</button>
			</form>
		</div>
		<div class="panel">
			<div class="panel-head">
				<span class="panel-title"><i class="ti ti-list icon" style="color:var(--accent)"></i> Daftar ({ fmtInt(len(d.Users)) })</span>
			</div>
			<div class="table-responsive">
				<table class="data-table">
					<thead><tr><th>Nama</th><th>Email</th><th>Role</th><th>Aksi</th></tr></thead>
					<tbody>
						for _, u := range d.Users {
							<tr>
								<td><strong>{ u.Name }</strong></td>
								<td class="muted">{ u.Email }</td>
								<td><span class={ "badge " + roleBadge(u.Role) }>{ u.Role }</span></td>
								<td>
									<div class="row-actions">
										<form method="post" action={ templ.URL("/users/" + u.Email + "/role") } class="inline">
											<input type="hidden" name="role" value={ toggleRole(u.Role) }/>
											<button type="submit" class="btn btn-sm"><i class="ti ti-refresh icon"></i></button>
										</form>
										<form method="post" action={ templ.URL("/users/" + u.Email + "/delete") } class="inline"
											onsubmit="return confirm('Hapus user ini?')">
											<button type="submit" class="btn btn-sm btn-danger"><i class="ti ti-trash icon"></i></button>
										</form>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}

func roleBadge(r string) string {
	if r == "admin" {
		return "badge-role"
	}
	return "badge-ok"
}

func toggleRole(r string) string {
	if r == "admin" {
		return "petugas"
	}
	return "admin"
}

// Password — ganti password sendiri.
templ Password(user UserInfo, msg string, isErr bool) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-key icon" style="color:var(--accent)"></i> Ganti Password</h1>
		</div>
	</div>
	<div class="panel" style="max-width:440px; padding:22px">
		if msg != "" {
			if isErr {
				<div class="alert" style="background:rgba(239,68,68,.1); color:#DC2626; padding:10px 14px; border-radius:10px; margin-bottom:14px">{ msg }</div>
			} else {
				<div class="alert" style="background:var(--accent-soft); color:var(--accent-dark); padding:10px 14px; border-radius:10px; margin-bottom:14px">{ msg }</div>
			}
		}
		<form method="post" action="/password" class="stack">
			<label>Password Lama<input type="password" name="old" required/></label>
			<label>Password Baru (min 8)<input type="password" name="new" required minlength="8"/></label>
			<label>Ulangi Password Baru<input type="password" name="confirm" required minlength="8"/></label>
			<button type="submit" class="btn btn-primary btn-block"><i class="ti ti-device-floppy icon"></i> Simpan</button>
		</form>
	</div>
}
