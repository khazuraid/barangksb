package views

templ BarcodePage(d BarcodeData) {
	<h1>Generator Barcode / QR</h1>
	<div class="card">
		<p class="muted">Centang barang lalu cetak label. Scan hasil dengan kamera untuk verifikasi.</p>
		<table class="data-table">
			<thead><tr><th></th><th>SKU</th><th>Nama</th><th>Preview</th></tr></thead>
			<tbody>
				for _, it := range d.Items {
					<tr>
						<td><input type="checkbox" class="sheet-check" value={ it.ID }/></td>
						<td><code>{ it.SKU }</code></td>
						<td>{ it.Name }</td>
						<td><img src={ templ.URL("/barcode/" + it.ID + ".png") } alt={ "barcode " + it.SKU } height="40"/></td>
					</tr>
				}
			</tbody>
		</table>
		<div class="actions">
			<button type="button" class="btn btn-primary" onclick="printSheet()">🖨 Cetak Label Terpilih</button>
			<button type="button" class="btn" onclick="selectAll()">Pilih Semua</button>
		</div>
	</div>
}

templ BarcodeSheet(items []ItemRow) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<title>Label Barcode</title>
			<style>
				body { font-family: Arial, sans-serif; margin: 10mm; }
				.label-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6mm; }
				.label { text-align: center; border: 1px dashed #ccc; padding: 4px; page-break-inside: avoid; }
				.label .name { font-size: 11px; font-weight: bold; }
				.label .sku { font-size: 10px; font-family: monospace; }
			</style>
		</head>
		<body onload="window.print()">
			<div class="label-grid">
				for _, it := range items {
					<div class="label">
						<div class="name">{ it.Name }</div>
						<img src={ templ.URL("/barcode/" + it.ID + ".png") } height="50"/>
						<div class="sku">{ it.SKU }</div>
					</div>
				}
			</div>
		</body>
	</html>
}
