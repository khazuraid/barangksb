package views

// BarcodePage — grid card QR preview per barang, bukan tabel.
templ BarcodePage(d BarcodeData) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-qrcode"></i> QR Generator</h1>
			<div class="page-subtitle">Pilih barang untuk cetak label QR. Scan QR → buka halaman detail publik.</div>
		</div>
		<div class="d-flex gap-2">
			<button type="button" class="btn btn-sm btn-primary" onclick="printSheet()"><i class="ti ti-printer"></i> Cetak Terpilih</button>
			<button type="button" class="btn btn-sm" onclick="selectAll()"><i class="ti ti-checkbox"></i> Pilih Semua</button>
		</div>
	</div>

	if len(d.Items) == 0 {
		<div class="card">
			<div class="empty">
				<i class="ti ti-qrcode empty-icon"></i>
				<div class="empty-title">Belum ada barang</div>
				<div>Tambahkan barang untuk generate QR code.</div>
				<a href="/items/new" class="btn btn-primary" style="margin-top:12px"><i class="ti ti-plus"></i> Tambah Barang</a>
			</div>
		</div>
	} else {
		<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px">
			for _, it := range d.Items {
				<label class="card" style="padding:16px;text-align:center;cursor:pointer;display:block" x-data="{ checked:false }">
					<input type="checkbox" class="sheet-check" value={ it.ID } style="display:none" @change="checked=$event.target.checked"/>
					<div style="position:relative;margin-bottom:8px">
						<img src={ templ.URL("/barcode/" + it.ID + ".png?fmt=qr") } alt="" style="width:100px;height:100px;border-radius:10px;border:2px solid var(--border)"/>
						<span x-show="checked" style="position:absolute;top:-4px;right:-4px;width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;display:none;align-items:center;justify-content:center;font-size:14px">
							<i class="ti ti-check"></i>
						</span>
					</div>
					<div style="font-weight:700;font-size:.82rem;margin-bottom:2px" class="text-truncate-40">{ it.Name }</div>
					<code>{ it.SKU }</code>
				</label>
			}
		</div>
		<div style="margin-top:16px">
			@Pagination(d.Pager)
		</div>
	}
}

// BarcodeSheet — halaman cetak label.
templ BarcodeSheet(items []ItemRow) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<title>Label QR</title>
			<style>
				body { background:#fff; margin:12mm; font-family:"Inter",sans-serif; }
				.label-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8mm; }
				.label { text-align:center; border:1px dashed #ccc; border-radius:10px; padding:8px; page-break-inside:avoid; }
				.label .name { font-size:11px; font-weight:700; margin-bottom:4px; }
				.label .sku { font-size:10px; font-family:monospace; color:#666; }
			</style>
		</head>
		<body onload="window.print()">
			<div class="label-grid">
				for _, it := range items {
					<div class="label">
						<div class="name">{ it.Name }</div>
						<img src={ templ.URL("/barcode/" + it.ID + ".png?fmt=qr") } height="60"/>
						<div class="sku">{ it.SKU }</div>
					</div>
				}
			</div>
		</body>
	</html>
}
