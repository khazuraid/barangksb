package views

// BulkAdjust — opname massal CSV.
templ BulkAdjust(user UserInfo) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-clipboard-list"></i> Stok Opname Massal</h1>
			<div class="page-subtitle">Unggah CSV hasil hitung fisik untuk penyesuaian massal</div>
		</div>
	</div>

	<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px" class="bulk-grid">
		<div class="card">
			<div class="card-head"><span class="card-title"><i class="ti ti-upload" style="color:var(--accent)"></i> Upload CSV</span></div>
			<div class="card-body">
				<form method="post" action="/adjust/bulk" enctype="multipart/form-data" class="stack">
					<label>File CSV (sku,fisik)</label>
					<input type="file" name="file" accept=".csv,text/csv" required/>
					<button type="submit" class="btn btn-primary btn-block"><i class="ti ti-upload"></i> Proses Opname</button>
				</form>
			</div>
		</div>
		<div class="card">
			<div class="card-head"><span class="card-title"><i class="ti ti-file-text" style="color:var(--accent)"></i> Format CSV</span></div>
			<div class="card-body">
				<p class="muted" style="margin-bottom:8px">Dua kolom: <code>sku</code> dan <code>fisik</code> (angka stok aktual).</p>
				<pre class="sync-result">sku,fisik
ATK-2026-001,12
ATK-2026-002,3
MED-2024-001,5</pre>
				<p class="muted" style="margin-top:10px;font-size:.78rem">Sistem akan otomatis menghitung selisih dan mencatat penyesuaian (ADJUST+/ADJUST−).</p>
			</div>
		</div>
	</div>
	<style>@media(max-width:768px){.bulk-grid{grid-template-columns:1fr !important}}</style>
}

// BulkAdjustResult — hasil opname massal.
templ BulkAdjustResult(user UserInfo, ok, fail int, errs []string) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-clipboard-check"></i> Hasil Opname Massal</h1>
		</div>
	</div>

	<div class="stat-grid" style="grid-template-columns:1fr 1fr">
		<div class="stat">
			<div class="stat-icon green"><i class="ti ti-check"></i></div>
			<div class="stat-value">{ fmtInt(ok) }</div>
			<div class="stat-label">Berhasil Disesuaikan</div>
		</div>
		<div class="stat">
			<div class="stat-icon red"><i class="ti ti-x"></i></div>
			<div class="stat-value">{ fmtInt(fail) }</div>
			<div class="stat-label">Gagal</div>
		</div>
	</div>

	if len(errs) > 0 {
		<div class="card" style="margin-bottom:16px">
			<div class="card-head"><span class="card-title"><i class="ti ti-alert-circle" style="color:var(--danger)"></i> Rincian Gagal</span></div>
			<div class="card-body">
				<ul class="error-list">
					for _, e := range errs {
						<li style="color:var(--danger);margin-bottom:6px;font-size:.82rem">{ e }</li>
					}
				</ul>
			</div>
		</div>
	}
	<div class="d-flex gap-2">
		<a href="/adjust/bulk" class="btn btn-primary"><i class="ti ti-arrow-left"></i> Opname Lagi</a>
		<a href="/history" class="btn"><i class="ti ti-clock-hour-4"></i> Lihat Riwayat</a>
	</div>
}

// PhotoZipDone — hasil arsip foto.
templ PhotoZipDone(user UserInfo, count int) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-photo"></i> Arsip Foto</h1>
		</div>
	</div>
	<div class="card" style="padding:28px;text-align:center">
		<div class="stat-icon green" style="width:56px;height:56px;margin:0 auto 16px;font-size:1.6rem"><i class="ti ti-photo"></i></div>
		<p style="font-size:1.1rem;margin-bottom:6px"><strong>{ fmtInt(count) }</strong> foto ditemukan</p>
		<p class="muted">Arsip tersedia di folder <code>backups/</code></p>
		<a href="/" class="btn" style="margin-top:16px"><i class="ti ti-arrow-left"></i> Kembali</a>
	</div>
}
