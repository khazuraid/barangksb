package views

import (
	"inventariskantor/internal/models"
)

// CategoriesData — halaman kategori.
type CategoriesData struct {
	User  UserInfo
	Cats  []models.Category
	Total int
}

// Categories — tabel card layout sama dengan halaman Barang.
templ Categories(d CategoriesData) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-category-2"></i> Kategori Barang</h1>
			<div class="page-subtitle">{ fmtInt(len(d.Cats)) } kategori terdaftar</div>
		</div>
	</div>

	<!-- form tambah: card tipis di atas -->
	<div class="card" style="margin-bottom:16px">
		<div class="card-body" style="padding:14px 18px">
			<form method="post" action="/categories" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
				<div style="flex:1;min-width:200px">
					<label>Nama Kategori</label>
					<input type="text" name="name" required placeholder="cth: Alat Kebersihan"/>
				</div>
				<button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i> Tambah</button>
			</form>
		</div>
	</div>

	<!-- daftar: tabel card -->
	<div class="card">
		<div class="card-head">
			<span class="card-title"><i class="ti ti-list" style="color:var(--accent)"></i> Daftar Kategori</span>
		</div>
		<div class="table-wrap">
			<table class="tbl">
				<thead><tr><th>Nama</th><th>Slug</th><th>Aksi</th></tr></thead>
				<tbody>
					for _, c := range d.Cats {
						<tr>
							<td><strong>{ c.Name }</strong></td>
							<td class="muted"><code>{ c.ID }</code></td>
							<td>
								<div class="row-actions">
									<button type="button" class="icon-btn" onclick={ templ.JSFuncCall("toggleRename", c.ID) } title="Edit"><i class="ti ti-pencil"></i></button>
									<form method="post" action={ templ.URL("/categories/" + c.ID + "/delete") } class="inline"
										onsubmit="return confirm('Hapus kategori ini?')">
										<button type="submit" class="icon-btn danger" title="Hapus"><i class="ti ti-trash"></i></button>
									</form>
								</div>
							</td>
						</tr>
						<tr id={ "rename-" + c.ID } class="hidden">
							<td colspan="3">
								<form method="post" action={ templ.URL("/categories/" + c.ID + "/rename") } class="inline-form">
									<input type="text" name="name" value={ c.Name } required style="flex:1"/>
									<button type="submit" class="btn btn-sm btn-primary"><i class="ti ti-check"></i></button>
									<button type="button" class="btn btn-sm" onclick={ templ.JSFuncCall("toggleRename", c.ID) }><i class="ti ti-x"></i></button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(d.Cats) == 0 {
			<div class="empty"><i class="ti ti-category-2 empty-icon"></i><div class="empty-title">Belum ada kategori</div></div>
		}
	</div>
	<script>
		function toggleRename(id){ document.getElementById('rename-'+id).classList.toggle('hidden'); }
	</script>
}

// LocationsData — halaman lokasi.
type LocationsData struct {
	User  UserInfo
	Locs  []models.Location
	Total int
}

// Locations — tabel card layout sama dengan Kategori.
templ Locations(d LocationsData) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-map-pin"></i> Lokasi / Ruangan</h1>
			<div class="page-subtitle">{ fmtInt(len(d.Locs)) } lokasi terdaftar</div>
		</div>
	</div>

	<div class="card" style="margin-bottom:16px">
		<div class="card-body" style="padding:14px 18px">
			<form method="post" action="/locations" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
				<div style="flex:1;min-width:200px">
					<label>Nama Ruangan</label>
					<input type="text" name="name" required placeholder="cth: Ruang Poli Lt 2"/>
				</div>
				<button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i> Tambah</button>
			</form>
		</div>
	</div>

	<div class="card">
		<div class="card-head">
			<span class="card-title"><i class="ti ti-list" style="color:var(--accent)"></i> Daftar Lokasi</span>
		</div>
		<div class="table-wrap">
			<table class="tbl">
				<thead><tr><th>Nama</th><th>Slug</th><th>Aksi</th></tr></thead>
				<tbody>
					for _, l := range d.Locs {
						<tr>
							<td><strong>{ l.Name }</strong></td>
							<td class="muted"><code>{ l.ID }</code></td>
							<td>
								<div class="row-actions">
									<button type="button" class="icon-btn" onclick={ templ.JSFuncCall("toggleRename", "loc-"+l.ID) } title="Edit"><i class="ti ti-pencil"></i></button>
									<form method="post" action={ templ.URL("/locations/" + l.ID + "/delete") } class="inline"
										onsubmit="return confirm('Hapus lokasi ini?')">
										<button type="submit" class="icon-btn danger" title="Hapus"><i class="ti ti-trash"></i></button>
									</form>
								</div>
							</td>
						</tr>
						<tr id={ "rename-loc-" + l.ID } class="hidden">
							<td colspan="3">
								<form method="post" action={ templ.URL("/locations/" + l.ID + "/rename") } class="inline-form">
									<input type="text" name="name" value={ l.Name } required style="flex:1"/>
									<button type="submit" class="btn btn-sm btn-primary"><i class="ti ti-check"></i></button>
									<button type="button" class="btn btn-sm" onclick={ templ.JSFuncCall("toggleRename", "loc-"+l.ID) }><i class="ti ti-x"></i></button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(d.Locs) == 0 {
			<div class="empty"><i class="ti ti-map-pin empty-icon"></i><div class="empty-title">Belum ada lokasi</div></div>
		}
	</div>
	<script>
		function toggleRename(id){ document.getElementById('rename-'+id).classList.toggle('hidden'); }
	</script>
}
