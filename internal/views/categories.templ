package views

templ Categories(d CategoriesData) {
	@toggleRename()
	<div class="page-head">
		<h1>Kategori Barang</h1>
	</div>
	<div class="grid-2">
		<div class="card">
			<h2>Tambah Kategori</h2>
			<form method="post" action="/categories" class="stack">
				<label>Nama Kategori
					<input type="text" name="name" required placeholder="cth: Alat Kebersihan"/>
				</label>
				<button type="submit" class="btn btn-primary">Tambah</button>
			</form>
		</div>
		<div class="card">
			<h2>Daftar ({ fmtInt(len(d.Cats)) })</h2>
			<table class="data-table">
				<thead><tr><th>Nama</th><th>Aksi</th></tr></thead>
				<tbody>
					for _, c := range d.Cats {
						<tr>
							<td>{ c.Name }</td>
							<td class="row-actions">
								<button type="button" class="btn-link" onclick={ templ.JSFuncCall("toggleRename", c.ID) }>Edit</button>
								<form method="post" action={ templ.URL("/categories/" + c.ID + "/delete") } class="inline"
									onsubmit="return confirm('Hapus kategori ini?')">
									<button type="submit" class="btn-link danger">Hapus</button>
								</form>
							</td>
						</tr>
						<tr id={ "rename-" + c.ID } class="hidden">
							<td colspan="2">
								<form method="post" action={ templ.URL("/categories/" + c.ID + "/rename") } class="inline-form">
									<input type="text" name="name" value={ c.Name } required/>
									<button type="submit" class="btn btn-primary btn-sm">Simpan</button>
									<button type="button" class="btn btn-sm" onclick={ templ.JSFuncCall("toggleRename", c.ID) }>Batal</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
			if len(d.Cats) == 0 {
				<p class="muted">Belum ada kategori.</p>
			}
		</div>
	</div>
}

templ toggleRename() {
	<script>
		function toggleRename(id){
			var el = document.getElementById('rename-'+id);
			el.classList.toggle('hidden');
		}
	</script>
}
