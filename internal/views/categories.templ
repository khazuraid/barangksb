package views

import (
	"inventariskantor/internal/models"
)

// CategoriesData — halaman kategori.
type CategoriesData struct {
	User UserInfo
	Cats []models.Category
}

// Categories — grid card layout (bukan tabel), tambah di atas, list sebagai card grid.
templ Categories(d CategoriesData) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-category-2"></i> Kategori Barang</h1>
			<div class="page-subtitle">{ fmtInt(len(d.Cats)) } kategori terdaftar</div>
		</div>
	</div>

	<div class="card" style="margin-bottom:20px">
		<div class="card-head">
			<span class="card-title"><i class="ti ti-plus" style="color:var(--accent)"></i> Tambah Kategori Baru</span>
		</div>
		<div class="card-body">
			<form method="post" action="/categories" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
				<div style="flex:1;min-width:200px">
					<label>Nama Kategori</label>
					<input type="text" name="name" required placeholder="cth: Alat Kebersihan & Sanitasi"/>
				</div>
				<button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i> Tambah</button>
			</form>
		</div>
	</div>

	if len(d.Cats) == 0 {
		<div class="card">
			<div class="empty">
				<i class="ti ti-category-2 empty-icon"></i>
				<div class="empty-title">Belum ada kategori</div>
				<div>Tambahkan kategori pertama di atas.</div>
			</div>
		</div>
	} else {
		<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px">
			for _, c := range d.Cats {
				<div class="card" style="padding:18px" x-data="{ editing:false }">
					<div x-show="!editing" style="display:flex;align-items:center;justify-content:space-between">
						<div style="display:flex;align-items:center;gap:10px">
							<span class="stat-icon green" style="width:36px;height:36px;margin:0;font-size:1rem"><i class="ti ti-category"></i></span>
							<div>
								<div style="font-weight:700;font-size:.9rem">{ c.Name }</div>
								<div class="muted" style="font-size:.72rem"><code>{ c.ID }</code></div>
							</div>
						</div>
						<div class="row-actions">
							<button type="button" class="icon-btn" @click="editing=true" title="Edit"><i class="ti ti-pencil"></i></button>
							<form method="post" action={ templ.URL("/categories/" + c.ID + "/delete") } class="inline"
								onsubmit="return confirm('Hapus kategori ini?')">
								<button type="submit" class="icon-btn danger" title="Hapus"><i class="ti ti-trash"></i></button>
							</form>
						</div>
					</div>
					<form x-show="editing" style="display:none;flex-direction:row;gap:6px;align-items:center" method="post" action={ templ.URL("/categories/" + c.ID + "/rename") }>
						<input type="text" name="name" value={ c.Name } required style="flex:1"/>
						<button type="submit" class="btn btn-sm btn-primary"><i class="ti ti-check"></i></button>
						<button type="button" class="btn btn-sm" @click="editing=false"><i class="ti ti-x"></i></button>
					</form>
				</div>
			}
		</div>
	}
}

// LocationsData — halaman lokasi.
type LocationsData struct {
	User UserInfo
	Locs []models.Location
}

// Locations — grid card layout sama dengan kategori.
templ Locations(d LocationsData) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-map-pin"></i> Lokasi / Ruangan</h1>
			<div class="page-subtitle">{ fmtInt(len(d.Locs)) } lokasi terdaftar</div>
		</div>
	</div>

	<div class="card" style="margin-bottom:20px">
		<div class="card-head">
			<span class="card-title"><i class="ti ti-plus" style="color:var(--accent)"></i> Tambah Lokasi Baru</span>
		</div>
		<div class="card-body">
			<form method="post" action="/locations" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
				<div style="flex:1;min-width:200px">
					<label>Nama Ruangan</label>
					<input type="text" name="name" required placeholder="cth: Ruang Poli Lt 2"/>
				</div>
				<button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i> Tambah</button>
			</form>
		</div>
	</div>

	if len(d.Locs) == 0 {
		<div class="card">
			<div class="empty">
				<i class="ti ti-map-pin empty-icon"></i>
				<div class="empty-title">Belum ada lokasi</div>
				<div>Tambahkan lokasi pertama di atas.</div>
			</div>
		</div>
	} else {
		<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px">
			for _, l := range d.Locs {
				<div class="card" style="padding:18px" x-data="{ editing:false }">
					<div x-show="!editing" style="display:flex;align-items:center;justify-content:space-between">
						<div style="display:flex;align-items:center;gap:10px">
							<span class="stat-icon blue" style="width:36px;height:36px;margin:0;font-size:1rem"><i class="ti ti-building"></i></span>
							<div>
								<div style="font-weight:700;font-size:.9rem">{ l.Name }</div>
								<div class="muted" style="font-size:.72rem"><code>{ l.ID }</code></div>
							</div>
						</div>
						<div class="row-actions">
							<button type="button" class="icon-btn" @click="editing=true" title="Edit"><i class="ti ti-pencil"></i></button>
							<form method="post" action={ templ.URL("/locations/" + l.ID + "/delete") } class="inline"
								onsubmit="return confirm('Hapus lokasi ini?')">
								<button type="submit" class="icon-btn danger" title="Hapus"><i class="ti ti-trash"></i></button>
							</form>
						</div>
					</div>
					<form x-show="editing" style="display:none;flex-direction:row;gap:6px;align-items:center" method="post" action={ templ.URL("/locations/" + l.ID + "/rename") }>
						<input type="text" name="name" value={ l.Name } required style="flex:1"/>
						<button type="submit" class="btn btn-sm btn-primary"><i class="ti ti-check"></i></button>
						<button type="button" class="btn btn-sm" @click="editing=false"><i class="ti ti-x"></i></button>
					</form>
				</div>
			}
		</div>
	}
}
