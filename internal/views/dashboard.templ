package views


// DashboardData v3 — bento + chart + tren.



// Dashboard v5 — bento grid, stat cards dengan icon berwarna,
// panel chart bar gradient, tabel mutasi modern.
templ Dashboard(d DashboardData) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-layout-dashboard"></i> Dashboard</h1>
			<div class="page-subtitle">Selamat datang, { d.User.Name } — ringkasan inventaris hari ini</div>
		</div>
		<div class="d-flex gap-2">
			<a href="/movement" class="btn"><i class="ti ti-arrows-exchange"></i> Mutasi</a>
			<a href="/items/new" class="btn btn-primary"><i class="ti ti-plus"></i> Tambah</a>
		</div>
	</div>

	<!-- stat cards -->
	<div class="stat-grid">
		<div class="stat">
			<div class="stat-icon green"><i class="ti ti-box-seam"></i></div>
			<div class="stat-value">{ fmtInt(d.TotalItems) }</div>
			<div class="stat-label">Jenis Barang</div>
		</div>
		<div class="stat">
			<div class="stat-icon violet"><i class="ti ti-stack-2"></i></div>
			<div class="stat-value">{ fmtInt(d.TotalStock) }</div>
			<div class="stat-label">Total Unit</div>
		</div>
		<div class="stat">
			<div class="stat-icon red"><i class="ti ti-alert-triangle"></i></div>
			<div class="stat-value">{ fmtInt(len(d.LowStock)) }</div>
			<div class="stat-label">Stok Menipis</div>
			if len(d.LowStock) > 0 {
				<div class="stat-trend">perlu direstock</div>
			}
		</div>
		<div class="stat">
			<div class="stat-icon amber"><i class="ti ti-category-2"></i></div>
			<div class="stat-value">{ fmtInt(len(d.Categories)) }</div>
			<div class="stat-label">Kategori</div>
		</div>
	</div>

	<!-- bento: chart + low stock -->
	<div class="bento mb-4">
		<div class="span-7 card">
			<div class="card-head">
				<span class="card-title"><i class="ti ti-chart-bar"></i> Stok per Kategori</span>
			</div>
			<div class="card-body">
				<div class="chart">
					for _, c := range sortedKeys(d.StockByCat) {
						<div class="chart-row">
							<span class="chart-label">{ c }</span>
							<div class="chart-bar"><div class="chart-fill" style={ barWidth(d.StockByCat[c], d.StockByCat) }></div></div>
							<span class="chart-num">{ fmtInt(d.StockByCat[c]) }</span>
						</div>
					}
					if len(d.StockByCat) == 0 {
						<div class="empty"><i class="ti ti-chart-donut empty-icon"></i><div class="empty-title">Belum ada data</div></div>
					}
				</div>
			</div>
		</div>
		<div class="span-5 card">
			<div class="card-head">
				<span class="card-title"><i class="ti ti-alert-triangle" style="color:var(--danger)"></i> Perlu Restock</span>
				<a href="/items" class="btn btn-sm">Semua</a>
			</div>
			<div class="card-body" style="max-height:320px;overflow-y:auto">
				if len(d.LowStock) == 0 {
					<div class="empty"><i class="ti ti-circle-check empty-icon" style="color:var(--accent)"></i><div class="empty-title">Semua stok aman</div></div>
				}
				for _, r := range d.LowStock {
					<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border-light)">
						<div>
							<div style="font-weight:600;font-size:.85rem">{ r.Name }</div>
							<code>{ r.SKU }</code>
							<span class="muted" style="font-size:.75rem"> — { r.Location }</span>
						</div>
						<span class="badge badge-danger">{ fmtInt(r.Current) }/{ fmtInt(r.Min) } { r.Unit }</span>
					</div>
				}
			</div>
		</div>
	</div>

	<!-- mutasi terbaru -->
	<div class="card">
		<div class="card-head">
			<span class="card-title"><i class="ti ti-clock-hour-4"></i> Mutasi Terbaru</span>
			<a href="/history" class="btn btn-sm">Lihat semua</a>
		</div>
		<div class="table-wrap">
			<table class="tbl">
				<thead><tr><th>Waktu</th><th>Jenis</th><th>Barang</th><th>Qty</th></tr></thead>
				<tbody>
					for _, r := range d.RecentTX {
						<tr>
							<td class="muted">{ r.Time }</td>
							<td><span class={ "badge " + txBadge(r.Type) }>{ r.Type }</span></td>
							<td><strong>{ r.ItemName }</strong> <code>{ r.SKU }</code></td>
							<td><strong>{ txQty(r.Type, r.Quantity, r.Unit) }</strong></td>
						</tr>
					}
					if len(d.RecentTX) == 0 {
						<tr><td colspan="4" style="text-align:center;padding:24px" class="muted">Belum ada mutasi.</td></tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<div style="margin-top:20px" class="d-flex gap-2">
		<a href="/export/items.csv" class="btn"><i class="ti ti-file-download"></i> CSV</a>
		<a href="/export/items.xlsx" class="btn"><i class="ti ti-table"></i> Excel</a>
		<a href="/report.pdf" class="btn"><i class="ti ti-file-type-pdf"></i> PDF</a>
	</div>
}

func txBadge(t string) string {
	switch t {
	case "IN":
		return "badge-in"
	case "OUT":
		return "badge-out"
	default:
		return "badge-adj"
	}
}

func txQty(t string, q int, unit string) string {
	switch t {
	case "IN":
		return "+" + fmtInt(q) + " " + unit
	case "OUT":
		return "−" + fmtInt(q) + " " + unit
	default:
		return "~" + fmtInt(q) + " " + unit
	}
}

var _ = templ.Component(nil)
