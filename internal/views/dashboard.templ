package views

templ Dashboard(d DashboardData) {
	<div class="page-header mb-3">
		<div class="row align-items-center">
			<div class="col"><h1 class="page-title">Dashboard</h1><div class="text-secondary mt-1">Ringkasan inventaris kantor</div></div>
			<div class="col-auto">
				<a href="/items/new" class="btn btn-primary"><i class="ti ti-plus icon"></i> Tambah Barang</a>
			</div>
		</div>
	</div>

	<div class="row row-deck row-cards mb-3">
		<div class="col-sm-6 col-lg-3">
			<div class="card card-sm">
				<div class="card-body">
					<div class="row align-items-center">
						<div class="col-auto"><span class="bg-blue text-white avatar"><i class="ti ti-box icon"></i></span></div>
						<div class="col"><div class="subheader">Jenis Barang</div><div class="h1 mb-0">{ fmtInt(d.TotalItems) }</div></div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-sm-6 col-lg-3">
			<div class="card card-sm">
				<div class="card-body">
					<div class="row align-items-center">
						<div class="col-auto"><span class="bg-red text-white avatar"><i class="ti ti-alert-triangle icon"></i></span></div>
						<div class="col"><div class="subheader">Stok Menipis</div><div class="h1 mb-0 text-danger">{ fmtInt(len(d.LowStock)) }</div></div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-sm-6 col-lg-3">
			<div class="card card-sm">
				<div class="card-body">
					<div class="row align-items-center">
						<div class="col-auto"><span class="bg-green text-white avatar"><i class="ti ti-category icon"></i></span></div>
						<div class="col"><div class="subheader">Kategori</div><div class="h1 mb-0">{ fmtInt(len(d.Categories)) }</div></div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-sm-6 col-lg-3">
			<div class="card card-sm">
				<div class="card-body">
					<div class="row align-items-center">
						<div class="col-auto"><span class="bg-purple text-white avatar"><i class="ti ti-arrows-left-right icon"></i></span></div>
						<div class="col"><div class="subheader">Mutasi Terakhir</div><div class="h1 mb-0">{ fmtInt(len(d.RecentTX)) }</div></div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row row-deck row-cards">
		<div class="col-lg-6">
			<div class="card">
				<div class="card-header"><h2 class="card-title"><i class="ti ti-alert-triangle icon text-danger"></i> Stok Menipis</h2></div>
				<div class="table-responsive">
					if len(d.LowStock) == 0 {
						<div class="card-body text-secondary">✓ Semua stok aman.</div>
					} else {
						<table class="table card-table table-vcenter">
							<thead><tr><th>Nama</th><th>SKU</th><th>Stok</th></tr></thead>
							<tbody>
								for _, r := range d.LowStock {
									<tr>
										<td>{ r.Name }</td>
										<td><code>{ r.SKU }</code></td>
										<td><span class="badge bg-danger-lt">{ fmtInt(r.Current) } / min { fmtInt(r.Min) }</span></td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			</div>
		</div>
		<div class="col-lg-6">
			<div class="card">
				<div class="card-header"><h2 class="card-title"><i class="ti ti-arrow-down icon text-green"></i> Barang Masuk Terbaru</h2></div>
				<div class="table-responsive">
					if len(d.RecentTX) == 0 {
						<div class="card-body text-secondary">Belum ada transaksi.</div>
					} else {
						<table class="table card-table table-vcenter">
							<thead><tr><th>Waktu</th><th>Barang</th><th>Qty</th></tr></thead>
							<tbody>
								for _, r := range d.RecentTX {
									<tr>
										<td class="text-secondary">{ r.Time }</td>
										<td>{ r.ItemName } <code>{ r.SKU }</code></td>
										<td><span class="badge bg-green-lt">+{ fmtInt(r.Quantity) }</span></td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			</div>
		</div>
	</div>

	<div class="card mt-3">
		<div class="card-header"><h2 class="card-title"><i class="ti ti-chart-bar icon"></i> Stok per Kategori</h2></div>
		<div class="card-body">
			<div class="chart">
				for _, c := range sortedKeys(d.StockByCat) {
					<div class="chart-row">
						<span class="chart-label">{ c }</span>
						<div class="chart-bar"><div class="chart-fill" style={ barWidth(d.StockByCat[c], d.StockByCat) }></div></div>
						<span class="chart-num">{ fmtInt(d.StockByCat[c]) }</span>
					</div>
				}
			</div>
		</div>
	</div>

	<div class="mt-3 d-flex gap-2">
		<a href="/export/items.csv" class="btn"><i class="ti ti-file-download icon"></i> CSV</a>
		<a href="/export/items.xlsx" class="btn"><i class="ti ti-table icon"></i> Excel</a>
		<a href="/report.pdf" class="btn"><i class="ti ti-file-type-pdf icon"></i> PDF</a>
	</div>
}
