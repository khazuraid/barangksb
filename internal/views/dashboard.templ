package views

import (
	"encoding/json"
)

// Dashboard v2 — bento grid + chart + tabel modern.
templ Dashboard(d DashboardData) {
	<div class="page-header">
		<div>
			<h1 class="page-title">Selamat datang, { d.User.Name } 👋</h1>
			<div class="page-subtitle">Ringkasan inventaris kantor hari ini</div>
		</div>
		<div class="d-flex gap-2">
			<a href="/movement" class="btn"><i class="ti ti-arrows-exchange icon"></i> Mutasi</a>
			<a href="/items/new" class="btn btn-primary"><i class="ti ti-plus icon"></i> Tambah Barang</a>
		</div>
	</div>

	<!-- Bento stat cards -->
	<div class="bento mb-4">
		<div class="span-3">
			<div class="stat-card">
				<div class="stat-icon teal"><i class="ti ti-box-seam"></i></div>
				<div class="stat-value">{ fmtInt(d.TotalItems) }</div>
				<div class="stat-label">Jenis Barang</div>
			</div>
		</div>
		<div class="span-3">
			<div class="stat-card">
				<div class="stat-icon violet"><i class="ti ti-stack-2"></i></div>
				<div class="stat-value">{ fmtInt(d.TotalStock) }</div>
				<div class="stat-label">Total Unit Stok</div>
			</div>
		</div>
		<div class="span-3">
			<div class="stat-card">
				<div class="stat-icon red"><i class="ti ti-alert-triangle"></i></div>
				<div class="stat-value">{ fmtInt(len(d.LowStock)) }</div>
				<div class="stat-label">Stok Menipis</div>
				<div class="stat-trend">perlu segera direstock</div>
			</div>
		</div>
		<div class="span-3">
			<div class="stat-card">
				<div class="stat-icon amber"><i class="ti ti-category-2"></i></div>
				<div class="stat-value">{ fmtInt(len(d.Categories)) }</div>
				<div class="stat-label">Kategori Aktif</div>
			</div>
		</div>
	</div>

	<!-- Chart + low stock -->
	<div class="bento mb-4">
		<div class="span-7 panel" style="grid-column: span 7">
			<div class="panel-head">
				<span class="panel-title"><i class="ti ti-chart-bar"></i> Stok per Kategori</span>
			</div>
			<div class="panel-body">
				<div class="chart" id="cat-chart">
					for _, c := range sortedKeys(d.StockByCat) {
						<div class="chart-row">
							<span class="chart-label">{ c }</span>
							<div class="chart-bar"><div class="chart-fill" style={ barWidth(d.StockByCat[c], d.StockByCat) }></div></div>
							<span class="chart-num">{ fmtInt(d.StockByCat[c]) }</span>
						</div>
					}
					if len(d.StockByCat) == 0 {
						<div class="empty"><i class="ti ti-chart-donut empty-icon"></i><div>Belum ada data stok</div></div>
					}
				</div>
			</div>
		</div>
		<div class="span-5 panel" style="grid-column: span 5">
			<div class="panel-head">
				<span class="panel-title"><i class="ti ti-alert-triangle text-danger"></i> Perlu Restock</span>
				<a href="/items" class="btn btn-sm">Lihat semua</a>
			</div>
			<div class="panel-body" style="max-height: 320px; overflow-y: auto">
				if len(d.LowStock) == 0 {
					<div class="empty"><i class="ti ti-circle-check empty-icon"></i><div>Semua stok aman ✓</div></div>
				}
				for _, r := range d.LowStock {
					<div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px solid rgba(107,114,128,.08)">
						<div>
							<div style="font-weight:600">{ r.Name }</div>
							<code>{ r.SKU }</code>
						</div>
						<span class="badge badge-danger">{ fmtInt(r.Current) } / { fmtInt(r.Min) } { r.Unit }</span>
					</div>
				}
			</div>
		</div>
	</div>

	<!-- Recent mutations -->
	<div class="panel">
		<div class="panel-head">
			<span class="panel-title"><i class="ti ti-clock-hour-4"></i> Mutasi Terbaru</span>
			<a href="/history" class="btn btn-sm">Riwayat lengkap</a>
		</div>
		<div class="table-responsive">
			<table class="data-table">
				<thead><tr><th>Waktu</th><th>Jenis</th><th>Barang</th><th>Qty</th></tr></thead>
				<tbody>
					for _, r := range d.RecentTX {
						<tr>
							<td class="muted">{ r.Time }</td>
							<td><span class={ "badge " + txBadge(r.Type) }>{ r.Type }</span></td>
							<td><strong>{ r.ItemName }</strong> <code>{ r.SKU }</code></td>
							<td><strong>{ txQty(r.Type, r.Quantity, r.Unit) }</strong></td>
						</tr>
					}
					if len(d.RecentTX) == 0 {
						<tr><td colspan="4" class="muted" style="text-align:center; padding:30px">Belum ada mutasi barang.</td></tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<div class="mt-4 d-flex gap-2">
		<a href="/export/items.csv" class="btn"><i class="ti ti-file-download icon"></i> CSV</a>
		<a href="/export/items.xlsx" class="btn"><i class="ti ti-table icon"></i> Excel</a>
		<a href="/report.pdf" class="btn"><i class="ti ti-file-type-pdf icon"></i> PDF</a>
	</div>
}

func txBadge(t string) string {
	switch t {
	case "IN":
		return "badge-in"
	case "OUT":
		return "badge-out"
	default:
		return "badge-adj"
	}
}

func txQty(t string, q int, unit string) string {
	switch t {
	case "IN":
		return "+" + fmtInt(q) + " " + unit
	case "OUT":
		return "−" + fmtInt(q) + " " + unit
	default:
		return "� " + fmtInt(q) + " " + unit
	}
}

var _ = json.Marshal
