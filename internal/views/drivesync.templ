package views

// DriveSync — sinkronisasi Google Drive.
templ DriveSync(d DriveSyncData) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-cloud-download icon" style="color:var(--accent)"></i> Sinkron Google Drive</h1>
			<div class="page-subtitle">Ambil data dari Drive (one-way: Drive → DB)</div>
		</div>
	</div>
	<div class="panel" style="padding:22px">
		if !d.Configured {
			<div class="alert" style="background:rgba(59,130,246,.1); color:#2563EB; padding:12px 16px; border-radius:10px; margin-bottom:14px">
				<i class="ti ti-info-circle icon"></i> Drive belum dikonfigurasi. Set env <code>GOOGLE_SA_JSON</code> + <code>GOOGLE_FOLDER_ID</code>.
				Bagikan folder Drive ke email service account.
			</div>
		} else {
			<div class="panel-title" style="margin-bottom:14px">File CSV / Google Sheet di folder Drive akan di-upsert ke database (cocokkan kolom SKU).</div>
			if d.LastRun != "" {
				<div style="margin-bottom:14px">
					<strong>Sinkron terakhir:</strong> { d.LastRun }
					<pre class="sync-result" style="margin-top:8px">{ d.Result }</pre>
				</div>
			}
			<form method="post" action="/drivesync">
				<button type="submit" class="btn btn-primary"><i class="ti ti-refresh icon"></i> Sync Sekarang</button>
			</form>
		}
	</div>
}
