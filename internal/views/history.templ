package views

// History — riwayat mutasi dengan filter + pagination.
templ History(d HistoryData) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-clock-hour-4 icon" style="color:var(--accent)"></i> Riwayat Mutasi</h1>
			<div class="page-subtitle">{ fmtInt(d.Pager.Total) } transaksi tercatat</div>
		</div>
		<div class="d-flex gap-2">
			<a href="/export/tx.csv" class="btn"><i class="ti ti-file-download icon"></i> CSV</a>
			<a href="/export/items.xlsx" class="btn"><i class="ti ti-table icon"></i> Excel</a>
		</div>
	</div>

	<div class="filter-bar">
		<input type="search" name="sku" placeholder="SKU…" value={ d.FSKU }/>
		<select name="type">
			<option value="">Semua Jenis</option>
			for _, t := range d.Types {
				if t == d.FType {
					<option value={ t } selected>{ t }</option>
				} else {
					<option value={ t }>{ t }</option>
				}
			}
		</select>
		<input type="date" name="from" value={ d.FFrom }/>
		<input type="date" name="to" value={ d.FTo }/>
		<button class="btn btn-primary"><i class="ti ti-filter icon"></i> Filter</button>
		<a href="/history" class="btn"><i class="ti ti-rotate icon"></i></a>
	</div>

	<div class="panel">
		<div class="table-responsive">
			<table class="data-table">
				<thead>
					<tr><th>Waktu</th><th>Jenis</th><th>Barang</th><th>Qty</th><th>Person</th><th>Kondisi</th><th>Geotag</th></tr>
				</thead>
				<tbody>
					for _, t := range d.TX {
						<tr>
							<td class="muted">{ t.Time }</td>
							<td><span class={ "badge " + txBadge(t.Type) }>{ t.Type }</span></td>
							<td><code>{ t.SKU }</code> <span class="muted">{ t.Name }</span></td>
							<td><strong>{ txQty(t.Type, t.Quantity, t.Unit) }</strong></td>
							<td>{ t.ReceivedBy }</td>
							<td class="muted">{ t.Condition }</td>
							<td class="muted text-truncate-40">{ t.Geo }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(d.TX) == 0 {
			<div class="empty">
				<i class="ti ti-clock-hour-4 empty-icon"></i>
				<div class="empty-title">Tidak ada transaksi</div>
				<div>Coba ubah filter atau catat mutasi baru.</div>
			</div>
		}
		<div class="panel-foot">
			@Pagination(d.Pager)
		</div>
	</div>
}
