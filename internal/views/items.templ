package views


// ItemRow — baris tabel barang.
type ItemRow struct {
	ID           string
	SKU, Name    string
	Category     string
	Location     string
	CurrentStock int
	MinStock     int
	Unit         string
	Condition    string
}

// ItemsData — halaman daftar barang.
type ItemsData struct {
	User  UserInfo
	Items []ItemRow
	Query string
	Cat   string
	Loc   string
	Cats  []string
	Locs  []string
	Pager PaginationData
}

// Items — daftar barang dengan filter bar + QR thumbnail + badge stok + pagination.
templ Items(d ItemsData) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-box-seam"></i> Daftar Barang</h1>
			<div class="page-subtitle">{ fmtInt(d.Pager.Total) } item terdaftar</div>
		</div>
		<a href="/items/new" class="btn btn-primary"><i class="ti ti-plus"></i> Tambah Barang</a>
	</div>

	<div class="filter-bar">
		<input type="search" name="q" placeholder="Cari nama / SKU / lokasi…" value={ d.Query }/>
		<select name="cat">
			<option value="">Semua Kategori</option>
			for _, c := range d.Cats {
				if c == d.Cat {
					<option value={ c } selected>{ c }</option>
				} else {
					<option value={ c }>{ c }</option>
				}
			}
		</select>
		<select name="loc">
			<option value="">Semua Lokasi</option>
			for _, l := range d.Locs {
				if l == d.Loc {
					<option value={ l } selected>{ l }</option>
				} else {
					<option value={ l }>{ l }</option>
				}
			}
		</select>
		<button class="btn btn-primary btn-sm"><i class="ti ti-search"></i> Cari</button>
		<a href="/items" class="btn btn-sm"><i class="ti ti-rotate"></i></a>
	</div>

	<div class="card">
		<div class="table-wrap">
			<table class="tbl">
				<thead>
					<tr>
						<th>QR</th><th>SKU</th><th>Nama</th><th>Kategori</th>
						<th>Lokasi</th><th>Stok</th><th>Kondisi</th><th></th>
					</tr>
				</thead>
				<tbody>
					for _, it := range d.Items {
						<tr>
							<td><img src={ templ.URL("/barcode/" + it.ID + ".png?fmt=qr") } alt="" class="qr-thumb"/></td>
							<td><code>{ it.SKU }</code></td>
							<td><strong>{ it.Name }</strong></td>
							<td class="muted">{ it.Category }</td>
							<td>{ it.Location }</td>
							<td>
								if it.CurrentStock <= it.MinStock {
									<span class="badge badge-danger">{ fmtInt(it.CurrentStock) } { it.Unit }</span>
								} else {
									<span class="badge badge-ok">{ fmtInt(it.CurrentStock) } { it.Unit }</span>
								}
							</td>
							<td class="muted">{ it.Condition }</td>
							<td>
								<div class="row-actions">
									<a href={ templ.URL("/items/" + it.ID + "/edit") } class="icon-btn" title="Edit"><i class="ti ti-pencil"></i></a>
									<a href={ templ.URL("/barcode/sheet?ids=" + it.ID) } target="_blank" class="icon-btn" title="Cetak QR"><i class="ti ti-qrcode"></i></a>
									<form method="post" action={ templ.URL("/items/" + it.ID + "/delete") } class="inline"
										onsubmit="return confirm('Hapus barang ini?')">
										<button type="submit" class="icon-btn danger" title="Hapus"><i class="ti ti-trash"></i></button>
									</form>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(d.Items) == 0 {
			<div class="empty">
				<i class="ti ti-box-seam empty-icon"></i>
				<div class="empty-title">Tidak ada barang</div>
				<div style="margin-bottom:10px">Tambahkan barang pertama Anda.</div>
				<a href="/items/new" class="btn btn-primary"><i class="ti ti-plus"></i> Tambah Barang</a>
			</div>
		}
		<div class="card-foot">
			@Pagination(d.Pager)
		</div>
	</div>
}
