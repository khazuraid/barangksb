package views

// ============================================================
// ITEMS — daftar barang, Tabler card + pagination
// ============================================================

templ Items(d ItemsData) {
	<div class="page-header mb-3 d-print-none">
		<div class="row align-items-center">
			<div class="col">
				<h1 class="page-title"><i class="ti ti-box icon me-1"></i> Daftar Barang</h1>
				<div class="text-secondary mt-1">{ fmtInt(d.Pager.Total) } item terdaftar</div>
			</div>
			<div class="col-auto">
				<a href="/items/new" class="btn btn-primary"><i class="ti ti-plus icon"></i> Tambah Barang</a>
			</div>
		</div>
	</div>

	<div class="card d-print-none">
		<div class="card-body py-2">
			<form method="get" action="/items" class="row g-2 align-items-center">
				<div class="col-md-4">
					<input type="search" name="q" class="form-control form-control-sm" placeholder="Cari nama / SKU / lokasi…" value={ d.Query }/>
				</div>
				<div class="col-md-3">
					<select name="cat" class="form-select form-select-sm">
						<option value="">Semua Kategori</option>
						for _, c := range d.Cats {
							if c == d.Cat {
								<option value={ c } selected>{ c }</option>
							} else {
								<option value={ c }>{ c }</option>
							}
						}
					</select>
				</div>
				<div class="col-md-3">
					<select name="loc" class="form-select form-select-sm">
						<option value="">Semua Lokasi</option>
						for _, l := range d.Locs {
							if l == d.Loc {
								<option value={ l } selected>{ l }</option>
							} else {
								<option value={ l }>{ l }</option>
							}
						}
					</select>
				</div>
				<div class="col-md-2 d-flex gap-2">
					<button type="submit" class="btn btn-sm btn-primary flex-fill"><i class="ti ti-search icon"></i> Cari</button>
					<a href="/items" class="btn btn-sm"><i class="ti ti-x icon"></i></a>
				</div>
			</form>
		</div>
	</div>

	<div class="card mt-2">
		<div class="table-responsive">
			<table class="table table-vcenter card-table">
				<thead>
					<tr>
						<th>Barcode</th><th>SKU</th><th>Nama</th><th>Kategori</th>
						<th>Lokasi</th><th>Stok</th><th>Kondisi</th><th class="w-1"></th>
					</tr>
				</thead>
				<tbody>
					for _, it := range d.Items {
						<tr>
							<td><img src={ templ.URL("/barcode/" + it.ID + ".png?fmt=qr") } alt="" height="34" width="34" class="rounded"/></td>
							<td><code>{ it.SKU }</code></td>
							<td class="text-truncate-40"><strong>{ it.Name }</strong></td>
							<td class="text-secondary">{ it.Category }</td>
							<td>{ it.Location }</td>
							<td>
								if it.CurrentStock <= it.MinStock {
									<span class="badge bg-danger-lt">{ fmtInt(it.CurrentStock) } { it.Unit }</span>
								} else {
									<span class="badge bg-green-lt">{ fmtInt(it.CurrentStock) } { it.Unit }</span>
								}
							</td>
							<td class="text-secondary">{ it.Condition }</td>
							<td>
								<div class="row-actions">
									<a href={ templ.URL("/items/" + it.ID + "/edit") } class="btn btn-sm" title="Edit"><i class="ti ti-pencil icon"></i></a>
									<a href={ templ.URL("/barcode/sheet?ids=" + it.ID) } target="_blank" class="btn btn-sm" title="Cetak QR"><i class="ti ti-qrcode icon"></i></a>
									<form method="post" action={ templ.URL("/items/" + it.ID + "/delete") } class="inline"
										onsubmit="return confirm('Hapus barang ini?')">
										<button type="submit" class="btn btn-sm text-danger" title="Hapus"><i class="ti ti-trash icon"></i></button>
									</form>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(d.Items) == 0 {
			<div class="empty">
				<p class="empty-title">Tidak ada barang</p>
				<p class="empty-subtitle text-secondary">Mulai dengan menambahkan barang pertama Anda.</p>
				<a href="/items/new" class="btn btn-primary">Tambah Barang</a>
			</div>
		}
		<div class="card-footer d-print-none">
			@Pagination(d.Pager)
		</div>
	</div>
}
