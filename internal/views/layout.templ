package views

templ Layout(title string, user UserInfo, content templ.Component) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — Inventaris Kantor</title>
			<link rel="stylesheet" href="/static/vendor/tabler/tabler.min.css"/>
			<link rel="stylesheet" href="/static/vendor/icons/tabler-icons.min.css"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<link rel="stylesheet" href="/static/css/theme.css"/>
		</head>
		<body>
			if user.Name != "" {
				<nav class="navbar navbar-expand-md d-print-none">
					<div class="container-xl">
						<h1 class="navbar-brand mb-0 h1">📦 Inventaris Kantor</h1>
						<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu">
							<span class="navbar-toggler-icon"></span>
						</button>
						<div class="collapse navbar-collapse" id="navbar-menu">
							<ul class="navbar-nav mx-auto">
								<li class={ "nav-item", navActive("/", user.Active) }><a class="nav-link" href="/"><i class="ti ti-dashboard icon"></i> Dashboard</a></li>
								<li class={ "nav-item", navActive("/items", user.Active) }><a class="nav-link" href="/items"><i class="ti ti-box icon"></i> Barang</a></li>
								<li class={ "nav-item", navActive("/categories", user.Active) }><a class="nav-link" href="/categories"><i class="ti ti-category icon"></i> Kategori</a></li>
								<li class={ "nav-item", navActive("/locations", user.Active) }><a class="nav-link" href="/locations"><i class="ti ti-map-pin icon"></i> Lokasi</a></li>
								<li class={ "nav-item", navActive("/movement", user.Active) }><a class="nav-link" href="/movement"><i class="ti ti-arrows-left-right icon"></i> Mutasi</a></li>
								<li class={ "nav-item", navActive("/history", user.Active) }><a class="nav-link" href="/history"><i class="ti ti-history icon"></i> Riwayat</a></li>
								<li class={ "nav-item", navActive("/barcode", user.Active) }><a class="nav-link" href="/barcode"><i class="ti ti-qrcode icon"></i> QR</a></li>
								if user.Role == "admin" {
									<li class={ "nav-item", navActive("/users", user.Active) }><a class="nav-link" href="/users"><i class="ti ti-users icon"></i> Pengguna</a></li>
									<li class={ "nav-item", navActive("/audit", user.Active) }><a class="nav-link" href="/audit"><i class="ti ti-shield-lock icon"></i> Audit</a></li>
								}
							</ul>
							<div class="nav-item d-flex align-items-center gap-2">
								<a href="/drivesync" class="btn btn-outline-secondary btn-sm"><i class="ti ti-cloud-upload icon"></i> Sinkron</a>
								<a href="/password" class="avatar avatar-sm rounded-circle bg-green-lt">{ user.Name[0:1] }</a>
								<form method="post" action="/logout" class="d-inline"><button type="submit" class="btn btn-link btn-sm">Keluar</button></form>
							</div>
						</div>
					</div>
				</nav>
			}
			<main class="container-xl py-4">
				@content
			</main>
			<script src="/static/vendor/tabler/tabler.min.js" defer></script>
			<script src="/static/js/app.js" defer></script>
		</body>
	</html>
}

func navActive(path, current string) string {
	if current == path || (path == "/" && (current == "" || current == "/")) {
		return "active"
	}
	return ""
}
