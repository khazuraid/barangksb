package views

// Login — halaman publik (dipanggil via h.show tanpa user).
templ Login(err string) {
	<div class="login-page">
		<div class="login-box">
			<div class="login-brand">
				<div class="login-logo">IK</div>
				<h1>Inventaris Kantor</h1>
				<p class="muted">Sistem Barcode & Stok Real-Time</p>
			</div>
			if err != "" {
				<div class="alert alert-error" style="background:rgba(239,68,68,.1); color:#DC2626; padding:10px 14px; border-radius:10px; margin-bottom:14px">{ err }</div>
			}
			<form method="post" action="/login" class="stack">
				<label>Email
					<input type="email" name="email" required autofocus placeholder="nama@kantor.id"/>
				</label>
				<label>Password
					<input type="password" name="password" required placeholder="••••••••"/>
				</label>
				<button type="submit" class="btn btn-primary btn-block"><i class="ti ti-login icon"></i> Masuk</button>
			</form>
			<p class="login-foot"><i class="ti ti-shield-lock icon"></i> Akses terbatas untuk petugas & admin kantor.</p>
		</div>
	</div>
}

// LoginContent — versi yang dirender dalam layout (fallback).
templ LoginContent(err string) {
	@Login(err)
}
