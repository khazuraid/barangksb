package views

// Movement — single column, form first, scanner collapsible.
templ Movement(d MovementData) {
	<div class="page-header">
		<div>
			<h1 class="page-title"><i class="ti ti-arrows-exchange"></i> Mutasi Barang</h1>
			<div class="page-subtitle">Catat pergerakan stok</div>
		</div>
	</div>

	<div class="tabs">
		<a href="/movement?tab=in" class={ "tab", tabActive(d.Tab, "in") }><i class="ti ti-arrow-down"></i> Barang Masuk</a>
		<a href="/movement?tab=out" class={ "tab", tabActive(d.Tab, "out") }><i class="ti ti-arrow-up"></i> Barang Keluar</a>
		<a href="/movement?tab=adjust" class={ "tab", tabActive(d.Tab, "adjust") }><i class="ti ti-adjustments"></i> Stok Opname</a>
	</div>

	<!-- form: full width, primary focus -->
	<div class="card" style="margin-bottom:16px">
		<div class="card-head">
			<span class="card-title">
				if d.Tab == "out" {
					<i class="ti ti-arrow-up" style="color:var(--danger)"></i> Catat Barang Keluar
				} else if d.Tab == "adjust" {
					<i class="ti ti-adjustments" style="color:var(--warn)"></i> Stok Opname / Penyesuaian
				} else {
					<i class="ti ti-arrow-down" style="color:var(--accent)"></i> Catat Barang Masuk
				}
			</span>
		</div>
		<div class="card-body">
			if d.Tab == "out" {
				<form method="post" action="/movement/out" class="stack">
					<div class="grid-2-form">
						<label>Item *
							<select name="item_id" id="item-select" required>
								<option value="">— pilih barang —</option>
								for _, it := range d.Items {
									<option value={ it.SKU }>{ it.Name } ({ it.SKU }) — stok { fmtInt(it.CurrentStock) }</option>
								}
							</select>
						</label>
						<label>Jumlah Keluar *
							<input type="number" name="quantity" min="1" required placeholder="0"/>
						</label>
						<label>Diberikan Kepada
							<input type="text" name="received_by" placeholder="nama penerima"/>
						</label>
						<label>No PO / Referensi
							<input type="text" name="invoice_or_po_number" placeholder="opsional"/>
						</label>
					</div>
					<label>Keterangan
						<textarea name="notes" rows="2" placeholder="alasan keluar"></textarea>
					</label>
					<button type="submit" class="btn btn-danger btn-block"><i class="ti ti-arrow-up"></i> Catat Barang Keluar</button>
				</form>
			} else if d.Tab == "adjust" {
				<form method="post" action="/movement/adjust" class="stack">
					<div class="grid-2-form">
						<label>Item *
							<select name="item_id" id="item-select" required>
								<option value="">— pilih barang —</option>
								for _, it := range d.Items {
									<option value={ it.SKU }>{ it.Name } ({ it.SKU }) — stok sistem { fmtInt(it.CurrentStock) }</option>
								}
							</select>
						</label>
						<label>Stok Fisik Aktual *
							<input type="number" name="quantity" min="0" required placeholder="0"/>
						</label>
					</div>
					<label>Catatan Opname
						<textarea name="notes" rows="2" placeholder="alasan penyesuaian"></textarea>
					</label>
					<button type="submit" class="btn btn-primary btn-block"><i class="ti ti-check"></i> Simpan Penyesuaian</button>
				</form>
			} else {
				<form method="post" action="/movement" class="stack" enctype="multipart/form-data">
					<input type="hidden" name="geo_lat" id="geo_lat"/>
					<input type="hidden" name="geo_lng" id="geo_lng"/>
					<input type="hidden" name="geo_acc" id="geo_acc"/>
					<input type="hidden" name="geo_name" id="geo_name"/>
					<div class="grid-2-form">
						<label>Item *
							<select name="item_id" id="item-select" required>
								<option value="">— pilih barang —</option>
								for _, it := range d.Items {
									<option value={ it.ID }>{ it.Name } ({ it.SKU })</option>
								}
							</select>
						</label>
						<label>Jumlah Masuk *
							<input type="number" name="quantity" min="1" required placeholder="0"/>
						</label>
						<label>Petugas Penerima
							<input type="text" name="received_by" value={ d.User.Name }/>
						</label>
						<label>Distributor / Vendor
							<input type="text" name="supplier_or_source" placeholder="nama distributor"/>
						</label>
						<label>No PO / Surat Jalan
							<input type="text" name="invoice_or_po_number" placeholder="nomor PO"/>
						</label>
						<label>Kondisi
							<select name="condition_status">
								<option>Berfungsi</option>
								<option>Rusak Ringan</option>
								<option>Rusak Berat</option>
								<option>Perlu Kalibrasi</option>
							</select>
						</label>
					</div>
					<label>Foto Bukti Fisik (opsional — dikompres + geotag card otomatis)
						<input type="file" name="photo" accept="image/*" capture="environment"/>
					</label>
					<label>Keterangan
						<textarea name="notes" rows="2"></textarea>
					</label>
					<button type="submit" class="btn btn-primary btn-block"><i class="ti ti-arrow-down"></i> Catat Barang Masuk</button>
				</form>
			}
		</div>
	</div>

	<!-- scanner + geotag: secondary, below form -->
	<div class="card">
		<div class="card-head"><span class="card-title"><i class="ti ti-qrcode" style="color:var(--accent)"></i> Scan / Geotag</span></div>
		<div class="card-body">
			<div class="grid-2-form">
				<label>Scan SKU
					<input type="text" id="movement-sku" value={ d.SKU } placeholder="Scan QR atau ketik SKU…"/>
				</label>
				if d.Tab != "adjust" {
					<label>Geotag
						<button type="button" class="btn btn-block" id="btn-geotag"><i class="ti ti-map-pin"></i> Ambil Lokasi GPS</button>
					</label>
				}
			</div>
			<div style="margin-top:10px">
				<button type="button" class="btn btn-block" id="btn-scan"><i class="ti ti-camera"></i> Buka Kamera Scanner</button>
			</div>
			<div id="scanner-box" class="hidden" style="margin-top:10px"></div>
			<div id="item-lookup" class="muted" style="font-size:.78rem;margin-top:8px"></div>
			<span id="geotag-status" class="muted" style="font-size:.76rem"></span>
		</div>
	</div>

	<script src="/static/js/vendor/html5-qrcode.min.js" defer></script>
	<script src="/static/js/scanner.js" defer></script>
	<script src="/static/js/geotag.js" defer></script>
}

func tabActive(cur, tab string) string {
	if cur == tab || (cur == "" && tab == "in") {
		return "active"
	}
	return ""
}
