package views

// Pagination renders the pager bar.
templ Pagination(p PaginationData) {
	if p.Pages() > 1 {
		<div class="d-flex align-items-center flex-wrap gap-1">
			if p.HasPrev() {
				<a href={ templ.URL(p.URL(p.Page-1)) } class="btn btn-sm">‹</a>
			}
			for _, pg := range p.Window() {
				if pg == p.Page {
					<button class="btn btn-sm btn-primary">{ fmtInt(pg) }</button>
				} else {
					<a href={ templ.URL(p.URL(pg)) } class="btn btn-sm">{ fmtInt(pg) }</a>
				}
			}
			if p.HasNext() {
				<a href={ templ.URL(p.URL(p.Page+1)) } class="btn btn-sm">›</a>
			}
			<span class="text-secondary ms-auto" style="font-size:.75rem">{ fmtInt(p.Total) } data — hal. { fmtInt(p.Page) }/{ fmtInt(p.Pages()) }</span>
		</div>
	} else {
		<span class="text-secondary" style="font-size:.75rem">{ fmtInt(p.Total) } data</span>
	}
}
