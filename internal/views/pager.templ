package views

// Pagination — HTMX-powered: klik halaman → swap tabel tanpa reload.
// Selector per-page juga HTMX (hx-get + hx-target).
templ Pagination(p PaginationData) {
	<div class="d-flex align-items-center flex-wrap gap-1">
		if p.Pages() > 1 {
			if p.HasPrev() {
				<button class="pager-btn" hx-get={ templ.URL(p.URL(p.Page-1)) } hx-target="#data-target" hx-swap="innerHTML" hx-select="#data-target" hx-push-url="true">‹</button>
			}
			for _, pg := range p.Window() {
				if pg == p.Page {
					<span class="pager-btn pager-current">{ fmtInt(pg) }</span>
				} else {
					<button class="pager-btn" hx-get={ templ.URL(p.URL(pg)) } hx-target="#data-target" hx-swap="innerHTML" hx-select="#data-target" hx-push-url="true">{ fmtInt(pg) }</button>
				}
			}
			if p.HasNext() {
				<button class="pager-btn" hx-get={ templ.URL(p.URL(p.Page+1)) } hx-target="#data-target" hx-swap="innerHTML" hx-select="#data-target" hx-push-url="true">›</button>
			}
		}
		<span class="pager-info">{ fmtInt(p.Total) } data — hal. { fmtInt(p.Page) }/{ fmtInt(p.Pages()) }</span>
		if len(p.PerPageOptions) > 0 {
			<select hx-get={ templ.URL(p.BaseURL) } hx-target="#data-target" hx-swap="innerHTML" hx-select="#data-target" hx-push-url="true" hx-include="this" hx-vals='js:{per_page: this.value}' style="margin-left:auto;padding:4px 8px;border:1px solid var(--border);border-radius:6px;font-size:.75rem;background:var(--surface)">
				for _, opt := range p.PerPageOptions {
					if opt == p.PerPage {
						<option value={ fmtInt(opt) } selected>{ fmtInt(opt) } / hal</option>
					} else {
						<option value={ fmtInt(opt) }>{ fmtInt(opt) } / hal</option>
					}
				}
			</select>
		}
	</div>
}
