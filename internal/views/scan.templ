package views

// ScanDetail — halaman publik hasil scan QR (tanpa login).
type ScanDetailData struct {
	Cats []string
	Row  ScanRow
}

type ScanRow struct {
	ID           string
	SKU, Name    string
	Category     string
	Location     string
	CurrentStock int
	MinStock     int
	Unit         string
	Condition    string
	Merk         string
	TypeModel    string
	SerialNumber string
	Year         string
	Funding      string
	Distributor  string
	Description  string
	PhotoURL     string
	IsAvailable  bool
}

templ ScanDetail(d ScanDetailData) {
	<div class="content" style="max-width:700px; margin:0 auto; padding-top:30px">
		<div style="text-align:center; margin-bottom:20px">
			<span class="scan-badge"><i class="ti ti-qrcode"></i> Barcode Terdeteksi</span>
			<h1 class="page-title" style="font-size:1.4rem; margin:0">{ d.Row.Name }</h1>
			<p class="muted" style="margin-top:4px"><code>{ d.Row.SKU }</code> — { d.Row.Category }</p>
		</div>

		if !d.Row.IsAvailable {
			<div class="alert" style="background:rgba(239,68,68,.1); color:#DC2626; padding:10px 14px; border-radius:10px; margin-bottom:14px">
				<i class="ti ti-alert-circle icon"></i> Barang ini tercatat TIDAK ADA (hilang/dipinjam).
			</div>
		}
		if d.Row.CurrentStock <= d.Row.MinStock {
			<div class="alert" style="background:rgba(245,158,11,.12); color:#B45309; padding:10px 14px; border-radius:10px; margin-bottom:14px">
				<i class="ti ti-alert-triangle icon"></i> Stok menipis: { fmtInt(d.Row.CurrentStock) } { d.Row.Unit } (min { fmtInt(d.Row.MinStock) })
			</div>
		}

		<div class="grid-2">
			<div class="panel scan-card" style="text-align:center; padding:16px">
				if d.Row.PhotoURL != "" {
					<img src={ templ.URL(d.Row.PhotoURL) } alt={ d.Row.Name } class="scan-photo"/>
				}
				<img src={ templ.URL("/barcode/" + d.Row.ID + ".png?fmt=qr") } alt="" class="scan-qr"/>
				<div class="scan-sku muted">{ d.Row.SKU }</div>
			</div>
			<div class="panel">
				<div class="panel-head"><span class="panel-title"><i class="ti ti-info-circle icon" style="color:var(--accent)"></i> Detail Barang</span></div>
				<div class="table-responsive">
					<table class="data-table">
						<tr><th>Stok</th><td><span class={ "badge " + lowBadge(d.Row.CurrentStock, d.Row.MinStock) }>{ fmtInt(d.Row.CurrentStock) } { d.Row.Unit }</span></td></tr>
						<tr><th>Lokasi</th><td>{ d.Row.Location }</td></tr>
						<tr><th>Kondisi</th><td>{ d.Row.Condition }</td></tr>
						<tr><th>Merk / Type</th><td>{ d.Row.Merk } { d.Row.TypeModel }</td></tr>
						<tr><th>No Seri</th><td>{ d.Row.SerialNumber }</td></tr>
						<tr><th>Thn Pengadaan</th><td>{ d.Row.Year }</td></tr>
						<tr><th>Pendanaan</th><td>{ d.Row.Funding }</td></tr>
						<tr><th>Distributor</th><td>{ d.Row.Distributor }</td></tr>
						<tr><th>Keterangan</th><td>{ d.Row.Description }</td></tr>
					</table>
				</div>
			</div>
		</div>
		<p class="scan-foot muted" style="text-align:center">Halaman publik — data hanya baca. Petugas: <a href="/login">masuk ke sistem</a></p>
	</div>
}

func lowBadge(cur, min int) string {
	if cur <= min {
		return "badge-danger"
	}
	return "badge-ok"
}
